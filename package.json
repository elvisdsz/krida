{
  "name": "krida",
  "version": "0.1.0",
  "description": "An engine for building interactive experiences with real-time camera-based tracking.",
  "author": "Elvis Dsouza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elvisdsz/krida.git"
  },
  "homepage": "https://krida.js.org",
  "keywords": [
    "webcam",
    "canvas",
    "hand-tracking",
    "pose-estimation",
    "mediapipe",
    "computer-vision"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit && tsup"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "^0.10.32"
  }
}
